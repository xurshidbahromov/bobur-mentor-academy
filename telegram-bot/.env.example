# Bobur Mentor Academy — CRM Bot Environment Variables
# Copy this to .env and fill in the values

# From @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your deployed bot URL (Railway, Render, etc.)
WEBHOOK_URL=https://your-bot-domain.railway.app

# From Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Secret to protect the /notify endpoint
BOT_SECRET=make_up_a_strong_random_secret_here

# Port (Railway sets this automatically)
PORT=3001
